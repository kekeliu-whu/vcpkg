+////////////////////////////////////////////////////////////////////////////////
+// SimpleOpenCVCameraModel
+
+std::string SimpleOpenCVCameraModel::InitializeParamsInfo() {
+  return "f, cx, cy, k1, k2, p1, p2";
+}
+
+std::array<size_t, 1> SimpleOpenCVCameraModel::InitializeFocalLengthIdxs() {
+  return {0};
+}
+
+std::array<size_t, 2> SimpleOpenCVCameraModel::InitializePrincipalPointIdxs() {
+  return {1, 2};
+}
+
+std::array<size_t, 4> SimpleOpenCVCameraModel::InitializeExtraParamsIdxs() {
+  return {3, 4, 5, 6};
+}
+
+std::vector<double> SimpleOpenCVCameraModel::InitializeParams(
+    const double focal_length, const size_t width, const size_t height) {
+  return {focal_length, width / 2.0, height / 2.0, 0, 0, 0, 0};
+}
+
+template <typename T>
+bool SimpleOpenCVCameraModel::ImgFromCam(
+    const T* params, const T& u, const T& v, const T& w, T* x, T* y) {
+  if (w < std::numeric_limits<T>::epsilon()) {
+    return false;
+  }
+
+  const T f = params[0];
+  const T c1 = params[1];
+  const T c2 = params[2];
+
+  const T uu = u / w;
+  const T vv = v / w;
+
+  // Distortion
+  T du, dv;
+  Distortion(&params[3], uu, vv, &du, &dv);
+  *x = uu + du;
+  *y = vv + dv;
+
+  // Transform to image coordinates
+  *x = f * *x + c1;
+  *y = f * *y + c2;
+
+  return true;
+}
+
+bool SimpleOpenCVCameraModel::CamFromImg(
+    const double* params, double x, double y, double* u, double* v) {
+  const double f = params[0];
+  const double c1 = params[1];
+  const double c2 = params[2];
+
+  // Lift points to normalized plane
+  *u = (x - c1) / f;
+  *v = (y - c2) / f;
+
+  return IterativeUndistortion(&params[3], u, v);
+}
+
+template <typename T>
+void SimpleOpenCVCameraModel::Distortion(
+    const T* extra_params, const T& u, const T& v, T* du, T* dv) {
+  const T k1 = extra_params[0];
+  const T k2 = extra_params[1];
+  const T p1 = extra_params[2];
+  const T p2 = extra_params[3];
+
+  const T u2 = u * u;
+  const T uv = u * v;
+  const T v2 = v * v;
+  const T r2 = u2 + v2;
+  const T radial = k1 * r2 + k2 * r2 * r2;
+  *du = u * radial + T(2) * p1 * uv + p2 * (r2 + T(2) * u2);
+  *dv = v * radial + T(2) * p2 * uv + p1 * (r2 + T(2) * v2);
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// PolyFisheyeCameraModel
+
+std::string PolyFisheyeCameraModel::InitializeParamsInfo() {
+  return "fx, fy, skew, cx, cy, k2, k3, k4, k5, k6, k7";
+}
+
+std::array<size_t, 3> PolyFisheyeCameraModel::InitializeFocalLengthIdxs() {
+  return {0, 1, 2};
+}
+
+std::array<size_t, 2> PolyFisheyeCameraModel::InitializePrincipalPointIdxs() {
+  return {3, 4};
+}
+
+std::array<size_t, 6> PolyFisheyeCameraModel::InitializeExtraParamsIdxs() {
+  return {5, 6, 7, 8, 9, 10};
+}
+
+std::vector<double> PolyFisheyeCameraModel::InitializeParams(
+    const double focal_length, const size_t width, const size_t height) {
+  return {focal_length,
+          focal_length,
+          0,
+          width / 2.0,
+          height / 2.0,
+          0,
+          0,
+          0,
+          0,
+          0,
+          0};
+}
+
+template <typename T>
+T r(T k2, T k3, T k4, T k5, T k6, T k7, T theta) {
+  // clang-format off
+    return theta
+        + k2 * theta * theta
+        + k3 * theta * theta * theta
+        + k4 * theta * theta * theta * theta
+        + k5 * theta * theta * theta * theta * theta
+        + k6 * theta * theta * theta * theta * theta * theta
+        + k7 * theta * theta * theta * theta * theta * theta * theta;  // clang-format on
+}
+
+template <typename T>
+bool PolyFisheyeCameraModel::ImgFromCam(
+    const T* params, const T& u, const T& v, const T& w, T* x, T* y) {
+  const T A11 = params[0];
+  const T A22 = params[1];
+  const T A12 = params[2];
+  const T u0 = params[3];
+  const T v0 = params[4];
+  const T k2 = params[5];
+  const T k3 = params[6];
+  const T k4 = params[7];
+  const T k5 = params[8];
+  const T k6 = params[9];
+  const T k7 = params[10];
+
+  T len = sqrt(u * u + v * v + w * w);
+  T uu = u / len;
+  T vv = v / len;
+  T ww = w / len;
+
+  T theta = acos(ww);
+  T phi = atan2(vv, uu);
+
+  T r_sqr = r(k2, k3, k4, k5, k6, k7, theta);
+
+  Eigen::Matrix<T, 2, 1> p_u =
+      r_sqr * Eigen::Matrix<T, 2, 1>(cos(phi), sin(phi));
+
+  // Transform to image coordinates
+  *x = A11 * p_u(0) + A12 * p_u(1) + u0;
+  *y = A22 * p_u(1) + v0;
+
+  return true;
+}
+
+bool PolyFisheyeCameraModel::CamFromImg(
+    const double* params, double x, double y, double* u, double* v) {
+  const double f = params[0];
+  const double c1 = params[1];
+  const double c2 = params[2];
+
+  // Lift points to normalized plane
+  *u = (x - c1) / f;
+  *v = (y - c2) / f;
+
+  IterativeUndistortion(&params[3], u, v);
+
+  return true;
+}
+
+template <typename T>
+void PolyFisheyeCameraModel::Distortion(
+    const T* extra_params, const T& u, const T& v, T* du, T* dv) {
+  throw std::runtime_error(
+      "PolyFisheyeCameraModel does not support distortion.");
+}
+
